model User {
  id               Int          @id @default(autoincrement())
  email            String       @unique
  username         String       @unique
  displayName      String
  passwordHash     String
  bio              String       @default("")
  createdAt        DateTime     @default(now())
  ratings          Rating[]
  sentRequests     Friendship[] @relation("SentRequests")
  receivedRequests Friendship[] @relation("ReceivedRequests")
  sessions         Session[]
}

model Release {
  id          Int      @id @default(autoincrement())
  spotifyId   String   @unique
  title       String
  artist      String
  releaseYear Int
  kind        String   @default("ALBUM")
  coverUrl    String   @default("")
  ratings     Rating[]
}

model Rating {
  id        Int      @id @default(autoincrement())
  userId    Int
  releaseId Int
  user      User     @relation(fields: [userId], references: [id])
  release   Release  @relation(fields: [releaseId], references: [id])
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([releaseId, userId])
}

model Friendship {
  id          Int      @id @default(autoincrement())
  requesterId Int
  receiverId  Int
  requester   User     @relation("SentRequests", fields: [requesterId], references: [id])
  receiver    User     @relation("ReceivedRequests", fields: [receiverId], references: [id])
  status      String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requesterId, receiverId])
}

model Session {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}
