model User {
  id               Int            @id @default(autoincrement())
  email            String         @unique
  username         String         @unique
  displayName      String
  passwordHash     String
  bio              String         @default("")
  role             String         @default("USER") // USER, ADMIN
  createdAt        DateTime       @default(now())
  ratings          Rating[]
  verdicts         TrackVerdict[]
  sentRequests     Friendship[]   @relation("SentRequests")
  receivedRequests Friendship[]   @relation("ReceivedRequests")
  sessions         Session[]
}

model Release {
  id          Int      @id @default(autoincrement())
  externalId  String   @unique
  title       String
  artist      String
  releaseYear Int
  kind        String   @default("ALBUM")
  coverUrl    String   @default("")
  ratings     Rating[]
  tracks      Track[]
}

model Rating {
  id        Int      @id @default(autoincrement())
  userId    Int
  releaseId Int
  user      User     @relation(fields: [userId], references: [id])
  release   Release  @relation(fields: [releaseId], references: [id])
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([releaseId, userId])
}

model Track {
  id          Int            @id @default(autoincrement())
  externalId  String         @unique
  releaseId   Int
  release     Release        @relation(fields: [releaseId], references: [id])
  title       String
  trackNumber Int
  discNumber  Int            @default(1)
  verdicts    TrackVerdict[]
}

// A thumbs up or down on a single track, separate from the album score.
model TrackVerdict {
  id        Int      @id @default(autoincrement())
  userId    Int
  trackId   Int
  user      User     @relation(fields: [userId], references: [id])
  track     Track    @relation(fields: [trackId], references: [id])
  verdict   String // GOOD, BAD
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, trackId])
}

model Friendship {
  id          Int      @id @default(autoincrement())
  requesterId Int
  receiverId  Int
  requester   User     @relation("SentRequests", fields: [requesterId], references: [id])
  receiver    User     @relation("ReceivedRequests", fields: [receiverId], references: [id])
  status      String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requesterId, receiverId])
}

model Session {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}
